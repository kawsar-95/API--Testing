# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# For MySQL (production / per assignment spec):
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=blogdb
DB_USER=root
DB_PASSWORD=

# For local development without MySQL, switch to sqlite:
# DB_DIALECT=sqlite
# DB_STORAGE=./blogdb.sqlite

# JWT Configuration
JWT_SECRET=replace-this-with-a-strong-secret-in-production
JWT_EXPIRES_IN=7d
